{
  "name": "@app/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsx index.ts",
    "start": "node dist/index.js",
    "test": "node --import tsx --test app.test.ts index.test.ts",
    "test:behaviors": "node --import tsx ../packages/cucumber/catalog/run-layer.ts backend steps/application.steps.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./app": {
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    },
    "./config/connections": {
      "types": "./dist/config/connections.d.ts",
      "default": "./dist/config/connections.js"
    }
  },
  "dependencies": {
    "@app/schemas": "0.1.0",
    "express": "5.2.1",
    "helmet": "8.3.0"
  },
  "devDependencies": {
    "@app/behaviors": "0.1.0"
  }
}
