{
  "name": "@app/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite --port 4173",
    "test:unit": "node --import tsx --test services/*.test.ts",
    "test:browser": "npm --prefix .. run build:contracts && npm --prefix .. run build -w @app/backend && npm run build && playwright test",
    "test:browser:compose": "playwright test --config playwright.compose.config.ts",
    "test:browser:preview": "playwright test --config playwright.preview.config.ts",
    "test:behaviors:compose": "node --import tsx ../packages/cucumber/catalog/run-layer.ts frontend steps/application.steps.ts",
    "preview:test": "vite preview"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.3",
    "vite": "8.2.2",
    "@app/schemas": "0.1.0"
  },
  "devDependencies": {
    "@app/behaviors": "0.1.0"
  }
}
