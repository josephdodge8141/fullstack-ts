{
  "name": "@app/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite --port 4173",
    "test:unit": "node --import tsx --test services/*.test.ts design-system/themes/*.test.ts",
    "test:browser": "npm --prefix .. run build:contracts && npm --prefix .. run build -w @app/backend && npm run build && playwright test",
    "test:browser:compose": "playwright test --config playwright.compose.config.ts",
    "test:browser:preview": "playwright test --config playwright.preview.config.ts",
    "test:behaviors:compose": "node --import tsx ../packages/cucumber/catalog/run-layer.ts frontend steps/application.steps.ts",
    "preview:test": "vite preview"
  },
  "dependencies": {
    "@app/schemas": "0.1.0",
    "@base-ui/react": "1.8.0",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@shadcn/react": "0.3.1",
    "@tailwindcss/vite": "4.3.3",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.2.6",
    "date-fns": "4.4.0",
    "embla-carousel-react": "8.6.0",
    "input-otp": "1.5.0",
    "lucide-react": "1.48.0",
    "react": "19.2.8",
    "react-day-picker": "10.0.1",
    "react-dom": "19.2.8",
    "react-resizable-panels": "4.13.3",
    "react-router-dom": "7.18.3",
    "recharts": "3.8.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "vite": "8.2.2"
  },
  "devDependencies": {
    "@app/behaviors": "0.1.0"
  }
}
